# Initial Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# LLM API Keys (at least one required for AI features)
# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini - https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# AWS Configuration (for Athena database connections)
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# AWS Secrets Manager (optional, for production deployments)
# AWS_SECRET_NAME=queryboard-secrets-production

# Google Cloud (for BigQuery database connections)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
